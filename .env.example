# =============================================================================
# UCHI+ 環境変数のサンプル
# =============================================================================
# ローカル開発では .env.local にコピーして使う (.env.local は .gitignore 済み)。
# Cloud Run ではリビジョンの環境変数 / Secret Manager 参照として設定する。
#
# 【重要】このアプリは NEXT_PUBLIC_* を使わない。
# すべてサーバー実行時に読み、必要な値だけを Server Component 経由で
# ブラウザへ渡す。これにより同じ Docker イメージを
# dev -> staging -> prod へ昇格できる。
# =============================================================================

# -----------------------------------------------------------------------------
# GCP / Firebase (公開してよい設定 — Firebase コンソールで確認できる)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=uchi-plus-dev
FIREBASE_PROJECT_ID=uchi-plus-dev
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=uchi-plus-dev.firebaseapp.com
FIREBASE_APP_ID=1:1234567890:web:abcdef
FIREBASE_MESSAGING_SENDER_ID=1234567890

# 写真・領収書を保存するバケット (公開バケットにしないこと)
GCS_BUCKET=uchi-plus-dev-media

# アプリの公開 URL (メールリンク認証のリダイレクト先などに使う)
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 動作設定
# -----------------------------------------------------------------------------
# セッション Cookie の有効期間 (秒)。既定は 5 日。
SESSION_COOKIE_MAX_AGE_SECONDS=432000
# 署名付き URL (閲覧用) の有効期間 (秒)。短いほど安全、長いほど再発行が減る。
SIGNED_URL_TTL_SECONDS=1800
# ログレベル: debug | info | warn | error
LOG_LEVEL=info
# 通知の実装: noop | console | line
NOTIFICATION_DRIVER=console
# OCR の実装: dummy | vision
OCR_DRIVER=dummy

# -----------------------------------------------------------------------------
# Firebase Emulator (ローカル開発時のみ true)
# -----------------------------------------------------------------------------
USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# -----------------------------------------------------------------------------
# 秘密情報 (Secret Manager で管理する。ここには実値を書かない)
# -----------------------------------------------------------------------------
# Cloud Run では「シークレットを環境変数として公開」機能で注入する。
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# ローカルで本物の GCP に繋ぐ場合 (通常は不要)
# -----------------------------------------------------------------------------
# 推奨: `gcloud auth application-default login` を使う (鍵ファイルを作らない)
# どうしても必要な場合のみ、サービスアカウント JSON の中身をそのまま入れる:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
